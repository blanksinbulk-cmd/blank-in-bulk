# Copy this file to .env.local and fill in your own values.
# You get these from your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The ONLY email address allowed to log into /admin.
# This must match the email of the one Supabase Auth user you create for yourself.
ADMIN_EMAIL=you@example.com

# Used for WhatsApp links and default contact info shown before you edit it
# in the admin dashboard. Format: digits only, country code first, no + or spaces.
NEXT_PUBLIC_DEFAULT_WHATSAPP=27738766823

# Your live site URL once deployed (used for the sitemap and SEO tags).
# Update this after you get your Vercel URL or connect a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
